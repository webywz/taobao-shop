{
  "name": "@tb-pdd-image/extension",
  "displayName": "TB Image Extractor",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "manifest": {
    "name": "TB Image Extractor",
    "description": "Extract product images from Taobao and Tmall pages.",
    "permissions": [
      "alarms",
      "debugger",
      "pageCapture",
      "storage",
      "tabs"
    ],
    "host_permissions": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*/*"
    ]
  },
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build"
  },
  "dependencies": {
    "@tb-pdd-image/shared": "file:../../packages/shared",
    "plasmo": "^0.90.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.325",
    "@types/node": "^22.14.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.5",
    "typescript": "^5.8.3"
  }
}
